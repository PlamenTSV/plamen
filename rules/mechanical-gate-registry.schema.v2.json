{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plamen.mechanical_gate_registry.v2",
  "title": "Plamen mechanical-gate registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_revision",
    "registry_scope",
    "migration_status",
    "migration",
    "activation_inventory",
    "seam_taxonomy",
    "decision_class_taxonomy",
    "direction_taxonomy",
    "seam_budgets",
    "gate_records"
  ],
  "properties": {
    "schema_version": {
      "const": "plamen.mechanical_gate_registry.v2"
    },
    "registry_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "registry_scope": {
      "$ref": "#/$defs/registry_scope"
    },
    "migration_status": {
      "const": "BASELINING_EXISTING_ACTIVATIONS"
    },
    "migration": {
      "$ref": "#/$defs/migration"
    },
    "activation_inventory": {
      "$ref": "#/$defs/activation_inventory"
    },
    "seam_taxonomy": {
      "const": [
        "STARTUP_RESUME",
        "PRE_DISCOVERY",
        "POST_DISCOVERY",
        "PRE_VERIFY",
        "POST_VERIFY",
        "REPORT_ASSEMBLY"
      ]
    },
    "decision_class_taxonomy": {
      "const": [
        "RC_AGENT_MECHANIZABLE",
        "RECALL_GENERATOR",
        "PIPELINE_INTEGRITY",
        "PRECISION_DISCRIMINATOR",
        "TELEMETRY_ONLY"
      ]
    },
    "direction_taxonomy": {
      "const": [
        "GENERATE_ADD_ONLY",
        "REOPEN_ADD_ONLY",
        "RECONCILE_LOSSLESS",
        "CAP_DESTRUCTIVE",
        "FLOOR_RECALL_OPEN",
        "FLAG_TELEMETRY",
        "ROUTE_RECALL_OPEN",
        "CONSOLIDATE_LOSSLESS",
        "BLOCK_EXECUTION",
        "EXECUTE_TARGET",
        "VETO_SHIP"
      ]
    },
    "seam_budgets": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/seam_budget"
      }
    },
    "gate_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/gate_record"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_string": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_integer": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_ppm_integer": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        {
          "type": "null"
        }
      ]
    },
    "human_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "gate_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._][a-z0-9]+)+$"
    },
    "gate_id_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/gate_id"
      }
    },
    "nonempty_string_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "registry_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_version",
        "included_authorities",
        "excluded_control_families",
        "production_roots",
        "production_excludes",
        "scope_review_receipt_sha256"
      ],
      "properties": {
        "scope_version": {
          "const": "plamen.mechanical_gate_scope.v1"
        },
        "included_authorities": {
          "const": [
            "CANDIDATE_MEMBERSHIP",
            "OBLIGATION_LIFECYCLE",
            "DISPOSITION_OR_REPORT_TIER",
            "SEVERITY",
            "EVIDENCE_OR_SUCCESSOR_AUTHORITY",
            "TARGET_EXECUTION",
            "VERIFICATION_ROUTING",
            "SHIP_AUTHORITY"
          ]
        },
        "excluded_control_families": {
          "const": [
            "STRUCTURAL_SELF_VALIDATION",
            "TRANSACTION_MECHANICS",
            "PURE_DATA_UTILITIES",
            "UNCONSUMED_TOOL_OUTPUT",
            "MODEL_JUDGMENT",
            "NON_PRODUCTION_CODE",
            "POST_AUDIT_HUMAN_CLASSIFICATION"
          ]
        },
        "production_roots": {
          "const": [
            "scripts"
          ]
        },
        "production_excludes": {
          "$ref": "#/$defs/nonempty_string_array"
        },
        "scope_review_receipt_sha256": {
          "type": "null"
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_tree_digest",
        "source_tree_digest_algorithm",
        "baseline_gate_ids",
        "baseline_live_gate_count",
        "baseline_review_status",
        "baseline_reviewer",
        "baseline_reviewed_at",
        "baseline_review_receipt_sha256",
        "new_runtime_transitions_blocked"
      ],
      "properties": {
        "source_tree_digest": {
          "$ref": "#/$defs/sha256"
        },
        "source_tree_digest_algorithm": {
          "const": "sha256:plamen-source-tree-v1"
        },
        "baseline_gate_ids": {
          "$ref": "#/$defs/gate_id_array"
        },
        "baseline_live_gate_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "baseline_review_status": {
          "const": "UNREVIEWED"
        },
        "baseline_reviewer": {
          "type": "null"
        },
        "baseline_reviewed_at": {
          "type": "null"
        },
        "baseline_review_receipt_sha256": {
          "type": "null"
        },
        "new_runtime_transitions_blocked": {
          "const": true
        }
      }
    },
    "activation_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "manifest_path",
        "manifest_sha256",
        "source_tree_digest_algorithm",
        "source_tree_digest",
        "generator_version",
        "generator_digest",
        "independent_review_receipt_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "plamen.mechanical_gate_activation_inventory.v1"
        },
        "manifest_path": {
          "const": "rules/mechanical-gate-activation-baseline.v1.json"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_tree_digest_algorithm": {
          "const": "sha256:plamen-source-tree-v1"
        },
        "source_tree_digest": {
          "$ref": "#/$defs/sha256"
        },
        "generator_version": {
          "const": "plamen.mechanical_gate_inventory.stage1-v1"
        },
        "generator_digest": {
          "$ref": "#/$defs/sha256"
        },
        "independent_review_receipt_sha256": {
          "type": "null"
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_id",
        "module",
        "wrapper_symbol",
        "implementation_symbols",
        "hook_id",
        "phases",
        "pipelines",
        "modes",
        "ecosystems",
        "backends",
        "runtime_state",
        "code_digest_algorithm",
        "code_digest"
      ],
      "properties": {
        "activation_id": {
          "$ref": "#/$defs/gate_id"
        },
        "module": {
          "type": "string",
          "pattern": "^scripts/[A-Za-z0-9_./-]+\\.py$"
        },
        "wrapper_symbol": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "implementation_symbols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
          }
        },
        "hook_id": {
          "$ref": "#/$defs/gate_id"
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "STARTUP",
              "RECON",
              "BREADTH",
              "INVENTORY",
              "RESCAN",
              "PER_CONTRACT",
              "SEMANTIC_INVARIANTS",
              "DEPTH",
              "CHAIN",
              "VERIFY",
              "REPORT"
            ]
          }
        },
        "pipelines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SC",
              "L1"
            ]
          }
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "LIGHT",
              "CORE",
              "THOROUGH"
            ]
          }
        },
        "ecosystems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "EVM",
              "SOLANA",
              "APTOS",
              "SUI",
              "SOROBAN",
              "DAML",
              "L1_GO",
              "L1_RUST"
            ]
          }
        },
        "backends": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CLAUDE",
              "CODEX"
            ]
          }
        },
        "runtime_state": {
          "enum": [
            "RUNTIME",
            "LEGACY_NOT_MIGRATED",
            "NON_RUNTIME"
          ]
        },
        "code_digest_algorithm": {
          "enum": [
            "sha256:plamen-python-decision-closure-ast-v1",
            "sha256:plamen-python-module-bytes-v1"
          ]
        },
        "code_digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "pipelines": {
                "const": [
                  "SC"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "ecosystems": {
                "items": {
                  "enum": [
                    "EVM",
                    "SOLANA",
                    "APTOS",
                    "SUI",
                    "SOROBAN",
                    "DAML"
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "ecosystems": {
                "items": {
                  "enum": [
                    "L1_GO",
                    "L1_RUST"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "runtime_state": {
                "enum": [
                  "RUNTIME",
                  "NON_RUNTIME"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "code_digest_algorithm": {
                "const": "sha256:plamen-python-decision-closure-ast-v1"
              }
            }
          }
        }
      ]
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence_requirements",
        "evidence_receipt_sha256"
      ],
      "properties": {
        "status": {
          "const": "LEGACY_UNASSESSED"
        },
        "evidence_requirements": {
          "$ref": "#/$defs/nonempty_string_array"
        },
        "evidence_receipt_sha256": {
          "type": "null"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can_add",
        "can_remove",
        "can_lower_severity",
        "can_raise_severity",
        "can_block_execution",
        "can_execute_target",
        "can_clear_debt",
        "can_veto_ship",
        "direction",
        "subject_identity_schema",
        "join_rule",
        "monotonicity_claim",
        "invalid_authority_fallback"
      ],
      "properties": {
        "can_add": {
          "type": "boolean"
        },
        "can_remove": {
          "type": "boolean"
        },
        "can_lower_severity": {
          "type": "boolean"
        },
        "can_raise_severity": {
          "type": "boolean"
        },
        "can_block_execution": {
          "type": "boolean"
        },
        "can_execute_target": {
          "type": "boolean"
        },
        "can_clear_debt": {
          "type": "boolean"
        },
        "can_veto_ship": {
          "type": "boolean"
        },
        "direction": {
          "enum": [
            "GENERATE_ADD_ONLY",
            "REOPEN_ADD_ONLY",
            "RECONCILE_LOSSLESS",
            "CAP_DESTRUCTIVE",
            "FLOOR_RECALL_OPEN",
            "FLAG_TELEMETRY",
            "ROUTE_RECALL_OPEN",
            "CONSOLIDATE_LOSSLESS",
            "BLOCK_EXECUTION",
            "EXECUTE_TARGET",
            "VETO_SHIP"
          ]
        },
        "subject_identity_schema": {
          "type": "string",
          "minLength": 1
        },
        "join_rule": {
          "type": "string",
          "minLength": 1
        },
        "monotonicity_claim": {
          "type": "string",
          "minLength": 1
        },
        "invalid_authority_fallback": {
          "$ref": "#/$defs/failure_action"
        }
      }
    },
    "failure_action": {
      "enum": [
        "HARD_STOP_BEFORE_SIDE_EFFECT",
        "BLOCK_TARGET_EXECUTION",
        "RETAIN_UPSTREAM_AND_FLAG",
        "GENERATE_ADD_ONLY_WITH_DEBT",
        "SHADOW_ONLY_WITH_DEBT",
        "QUARANTINE_AND_RETRY",
        "UNKNOWN_DEBT_CONTINUE",
        "NOT_APPLICABLE"
      ]
    },
    "input_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_identity",
        "artifact_root",
        "schema_version",
        "authoritative_producer",
        "role",
        "subject_identity_schema",
        "join_rule",
        "freshness_rule",
        "absent_behavior",
        "malformed_behavior"
      ],
      "properties": {
        "artifact_identity": {
          "type": "string",
          "minLength": 1
        },
        "artifact_root": {
          "enum": [
            "scratchpad",
            "project"
          ]
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "authoritative_producer": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "EXACT",
            "BOUNDED_LOOKUP",
            "OPTIONAL_CAPABILITY"
          ]
        },
        "subject_identity_schema": {
          "type": "string",
          "minLength": 1
        },
        "join_rule": {
          "type": "string",
          "minLength": 1
        },
        "freshness_rule": {
          "type": "string",
          "minLength": 1
        },
        "absent_behavior": {
          "$ref": "#/$defs/failure_action"
        },
        "malformed_behavior": {
          "$ref": "#/$defs/failure_action"
        }
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_identity",
        "artifact_root",
        "schema_version",
        "phase_io_work_unit_id",
        "artifact_class",
        "writer",
        "write_mode",
        "minimum_gate",
        "consumers",
        "condition_id",
        "external_preimage_validator",
        "authority_carried"
      ],
      "properties": {
        "artifact_identity": {
          "type": "string",
          "minLength": 1
        },
        "artifact_root": {
          "enum": [
            "scratchpad",
            "project"
          ]
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "phase_io_work_unit_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_class": {
          "enum": [
            "REQUIRED",
            "OPTIONAL",
            "CONDITIONAL",
            "DRIVER_GENERATED"
          ]
        },
        "writer": {
          "enum": [
            "MODEL",
            "DRIVER"
          ]
        },
        "write_mode": {
          "enum": [
            "CREATE",
            "REPLACE",
            "APPEND",
            "MERGE"
          ]
        },
        "minimum_gate": {
          "type": "string",
          "minLength": 1
        },
        "consumers": {
          "$ref": "#/$defs/nonempty_string_array"
        },
        "condition_id": {
          "type": "string"
        },
        "external_preimage_validator": {
          "type": "string"
        },
        "authority_carried": {
          "enum": [
            "COMMON_RECEIPT",
            "GOVERNANCE_DEBT",
            "OVERFLOW_BACKLOG",
            "CANDIDATE",
            "OBLIGATION",
            "DISPOSITION",
            "SEVERITY",
            "EXECUTION_BLOCK",
            "SHIP_VETO",
            "TELEMETRY"
          ]
        }
      }
    },
    "failure_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absent",
        "malformed",
        "stale",
        "split",
        "duplicate",
        "contradictory",
        "provider_failure",
        "timeout",
        "budget_overflow",
        "receipt_failure",
        "input_mutation",
        "partial_resume"
      ],
      "properties": {
        "absent": {
          "$ref": "#/$defs/failure_action"
        },
        "malformed": {
          "$ref": "#/$defs/failure_action"
        },
        "stale": {
          "$ref": "#/$defs/failure_action"
        },
        "split": {
          "$ref": "#/$defs/failure_action"
        },
        "duplicate": {
          "$ref": "#/$defs/failure_action"
        },
        "contradictory": {
          "$ref": "#/$defs/failure_action"
        },
        "provider_failure": {
          "$ref": "#/$defs/failure_action"
        },
        "timeout": {
          "$ref": "#/$defs/failure_action"
        },
        "budget_overflow": {
          "$ref": "#/$defs/failure_action"
        },
        "receipt_failure": {
          "$ref": "#/$defs/failure_action"
        },
        "input_mutation": {
          "$ref": "#/$defs/failure_action"
        },
        "partial_resume": {
          "$ref": "#/$defs/failure_action"
        }
      }
    },
    "runtime_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "denominator_must_be_exact",
        "stable_shard_ordering",
        "overflow_action",
        "max_input_bytes",
        "max_input_files",
        "max_raw_rows",
        "max_unique_subjects",
        "max_eligible_subjects",
        "max_retained_or_fired",
        "max_emitted_candidates",
        "max_wall_clock_ms",
        "max_external_processes",
        "max_workers",
        "max_tokens"
      ],
      "properties": {
        "denominator_must_be_exact": {
          "type": "boolean"
        },
        "stable_shard_ordering": {
          "type": "string",
          "minLength": 1
        },
        "overflow_action": {
          "$ref": "#/$defs/failure_action"
        },
        "max_input_bytes": {
          "type": "null"
        },
        "max_input_files": {
          "type": "null"
        },
        "max_raw_rows": {
          "type": "null"
        },
        "max_unique_subjects": {
          "type": "null"
        },
        "max_eligible_subjects": {
          "type": "null"
        },
        "max_retained_or_fired": {
          "type": "null"
        },
        "max_emitted_candidates": {
          "type": "null"
        },
        "max_wall_clock_ms": {
          "type": "null"
        },
        "max_external_processes": {
          "type": "null"
        },
        "max_workers": {
          "type": "null"
        },
        "max_tokens": {
          "type": "null"
        }
      }
    },
    "release_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "replacement_gate_ids",
        "recall_parity_receipt_sha256",
        "system_owner_approval_sha256"
      ],
      "properties": {
        "status": {
          "const": "UNESTABLISHED"
        },
        "replacement_gate_ids": {
          "type": "array",
          "maxItems": 0
        },
        "recall_parity_receipt_sha256": {
          "type": "null"
        },
        "system_owner_approval_sha256": {
          "type": "null"
        }
      }
    },
    "false_fire_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "held_out_corpus_id",
        "held_out_corpus_sha256",
        "evaluator_principal",
        "gate_implementer_principal",
        "evaluator_build_sha256",
        "comparator_sha256",
        "observation_window_id",
        "minimum_adjudicated_denominator",
        "adjudicated_fire_count",
        "true_fire_count",
        "false_fire_count",
        "maximum_false_fire_count",
        "maximum_false_fire_rate_ppm",
        "current_evidence_receipt_sha256"
      ],
      "properties": {
        "status": {
          "const": "UNESTABLISHED"
        },
        "held_out_corpus_id": {
          "type": "null"
        },
        "held_out_corpus_sha256": {
          "type": "null"
        },
        "evaluator_principal": {
          "type": "null"
        },
        "gate_implementer_principal": {
          "type": "null"
        },
        "evaluator_build_sha256": {
          "type": "null"
        },
        "comparator_sha256": {
          "type": "null"
        },
        "observation_window_id": {
          "type": "null"
        },
        "minimum_adjudicated_denominator": {
          "type": "null"
        },
        "adjudicated_fire_count": {
          "type": "null"
        },
        "true_fire_count": {
          "type": "null"
        },
        "false_fire_count": {
          "type": "null"
        },
        "maximum_false_fire_count": {
          "type": "null"
        },
        "maximum_false_fire_rate_ppm": {
          "type": "null"
        },
