{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plamen.local/schemas/mechanical_program_facts_receipt.v2.schema.json",
  "title": "Program Facts v2 public receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_generation",
    "status",
    "authority_bindings",
    "provider_executions",
    "internal_cells",
    "public_projection_policy_digest",
    "receipt_body_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "plamen.mechanical_program_facts_receipt.v2"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "run_generation": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "authority_bindings": {
      "$ref": "#/$defs/authority"
    },
    "provider_executions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_id",
          "build_variant_id",
          "capability_id",
          "request_digest",
          "request_size",
          "environment_digest",
          "raw_cas",
          "execution_set_row_digest",
          "workspace_receipt_sha256",
          "slither_tool_row_sha256",
          "solc_tool_row_sha256",
          "build_variant_sha256",
          "dependency_closure_sha256"
        ],
        "properties": {
          "provider_id": {
            "type": "string",
            "minLength": 1
          },
          "build_variant_id": {
            "type": "string",
            "minLength": 1
          },
          "capability_id": {
            "type": "string",
            "minLength": 1
          },
          "request_digest": {
            "$ref": "#/$defs/sha256"
          },
          "request_size": {
            "type": "integer",
            "minimum": 0
          },
          "environment_digest": {
            "$ref": "#/$defs/sha256"
          },
          "raw_cas": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "digest",
              "size"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "$ref": "#/$defs/sha256"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "execution_set_row_digest": {
            "$ref": "#/$defs/sha256"
          },
          "workspace_receipt_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "slither_tool_row_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "solc_tool_row_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "build_variant_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "dependency_closure_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "internal_cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "build_variant_id",
          "internal_state",
          "public_status"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "minLength": 1
          },
          "build_variant_id": {
            "type": "string",
            "minLength": 1
          },
          "internal_state": {
            "type": "string",
            "minLength": 1
          },
          "public_status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "public_projection_policy_digest": {
      "$ref": "#/$defs/sha256"
    },
    "receipt_body_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "WRITTEN",
        "DEGRADED",
        "UNAVAILABLE",
        "FAILED",
        "STALE"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_authority_digest",
        "composition_authority_digest",
        "methodology_package_digest",
        "activation_decision_digest",
        "activation_permit_digest",
        "build_input_snapshot_digest",
        "candidate_universe_digest",
        "selected_scope_digest",
        "capability_selection_digest",
        "build_plan_digest",
        "execution_set_digest"
      ],
      "properties": {
        "execution_authority_digest": {
          "$ref": "#/$defs/sha256"
        },
        "composition_authority_digest": {
          "$ref": "#/$defs/sha256"
        },
        "methodology_package_digest": {
          "$ref": "#/$defs/sha256"
        },
        "activation_decision_digest": {
          "$ref": "#/$defs/sha256"
        },
        "activation_permit_digest": {
          "$ref": "#/$defs/sha256"
        },
        "build_input_snapshot_digest": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_universe_digest": {
          "$ref": "#/$defs/sha256"
        },
        "selected_scope_digest": {
          "$ref": "#/$defs/sha256"
        },
        "capability_selection_digest": {
          "$ref": "#/$defs/sha256"
        },
        "build_plan_digest": {
          "$ref": "#/$defs/sha256"
        },
        "execution_set_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
