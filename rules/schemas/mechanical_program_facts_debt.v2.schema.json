{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plamen.local/schemas/mechanical_program_facts_debt.v2.schema.json",
  "title": "Program Facts v2 typed debt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "authority_bindings",
    "rows",
    "terminal_negative_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "plamen.mechanical_program_facts_debt.v2"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "authority_bindings": {
      "$ref": "#/$defs/authority"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "debt_id",
          "reason_code",
          "terminal_negative_authority"
        ],
        "properties": {
          "debt_id": {
            "type": "string",
            "minLength": 1
          },
          "reason_code": {
            "type": "string",
            "minLength": 1
          },
          "capability_id": {
            "type": "string",
            "minLength": 1
          },
          "debt_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "terminal_negative_authority": {
            "const": false
          }
        }
      }
    },
    "terminal_negative_authority": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "WRITTEN",
        "DEGRADED",
        "UNAVAILABLE",
        "FAILED",
        "STALE"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_authority_digest",
        "composition_authority_digest",
        "methodology_package_digest",
        "activation_decision_digest",
        "activation_permit_digest",
        "build_input_snapshot_digest",
        "candidate_universe_digest",
        "selected_scope_digest",
        "capability_selection_digest",
        "build_plan_digest",
        "execution_set_digest"
      ],
      "properties": {
        "execution_authority_digest": {
          "$ref": "#/$defs/sha256"
        },
        "composition_authority_digest": {
          "$ref": "#/$defs/sha256"
        },
        "methodology_package_digest": {
          "$ref": "#/$defs/sha256"
        },
        "activation_decision_digest": {
          "$ref": "#/$defs/sha256"
        },
        "activation_permit_digest": {
          "$ref": "#/$defs/sha256"
        },
        "build_input_snapshot_digest": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_universe_digest": {
          "$ref": "#/$defs/sha256"
        },
        "selected_scope_digest": {
          "$ref": "#/$defs/sha256"
        },
        "capability_selection_digest": {
          "$ref": "#/$defs/sha256"
        },
        "build_plan_digest": {
          "$ref": "#/$defs/sha256"
        },
        "execution_set_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
