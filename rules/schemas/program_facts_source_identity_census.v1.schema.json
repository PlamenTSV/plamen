                  "VOCABULARY-KEYWORDS",
                  "CLOSED-OBJECTS",
                  "REF-CLOSURE",
                  "VECTOR-CARRIER",
                  "KEYWORD-OCCURRENCE-COVERAGE",
                  "POSITIVE-REPLAY",
                  "NEGATIVE-REPLAY",
                  "IDENTITY-STABLE-READ"
