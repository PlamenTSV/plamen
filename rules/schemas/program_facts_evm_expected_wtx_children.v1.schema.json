{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plamen.local/schemas/program_facts_evm_expected_wtx_children.v1.schema.json",
  "title": "Program Facts expected WTx children v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_generation",
    "execution_authority_digest",
    "build_plan_digest",
    "expected_child_count",
    "expected_wtx_children",
    "children_body_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "plamen.program_facts_evm_expected_wtx_children.v1"
    },
    "run_id": {
      "$ref": "#/$defs/identifier"
    },
    "run_generation": {
      "type": "integer",
      "minimum": 0
    },
    "execution_authority_digest": {
      "$ref": "#/$defs/sha256"
    },
    "build_plan_digest": {
      "$ref": "#/$defs/sha256"
    },
    "expected_child_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "expected_wtx_children": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/child"
      },
      "maxItems": 4096
    },
    "children_body_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "terminalArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_role",
        "producer_output_identity",
        "expected_relative_path"
      ],
      "properties": {
        "logical_role": {
          "$ref": "#/$defs/identifier"
        },
        "producer_output_identity": {
          "$ref": "#/$defs/identifier"
        },
        "expected_relative_path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_variant_id",
        "expected_work_unit_id",
        "expected_attempt_identity",
        "terminal_artifacts"
      ],
      "properties": {
        "selected_variant_id": {
          "$ref": "#/$defs/identifier"
        },
        "expected_work_unit_id": {
          "$ref": "#/$defs/identifier"
        },
        "expected_attempt_identity": {
          "$ref": "#/$defs/identifier"
        },
        "terminal_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/terminalArtifact"
          },
          "minItems": 1,
          "maxItems": 32
        }
      }
    }
  }
}
