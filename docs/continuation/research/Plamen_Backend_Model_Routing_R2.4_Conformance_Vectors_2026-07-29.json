  "expansion_rules": {
    "record_templates": "The offline validator constructs closed canonical base records for each named R2.4 authority and applies exactly the named mutation.",
    "digest_rule": "Every serialized authority self-digest is lowercase SHA-256 over restricted RFC 8785 canonical bytes with that digest member omitted.",
    "public_environment": "The public digest covers only ordered names, source classes, redaction markers, policy-authority digest sets, non-secret values, and public policy authorities.",
    "ephemeral_proof": "Secret-value integrity uses a fresh 256-bit per-process/per-object HMAC proof over the exact in-memory environment and launch-object identity; key and tag are never serialized.",
    "preservation": "Before any R2.4 vector, the validator hash-checks the six exact accepted R2.3 artifacts and runs the frozen R2.3 validator in isolated offline mode for all 186 vectors."
  },
