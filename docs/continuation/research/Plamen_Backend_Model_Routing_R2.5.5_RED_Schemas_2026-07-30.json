            "event_kind": {
              "const": "Q"
            },
            "payload": {
              "oneOf": [
                {
                  "$ref": "#/$defs/ObservedResolutionPayloadV1"
                },
                {
                  "$ref": "#/$defs/NoSpawnResolutionPayloadV1"
                }
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "SpawnedAttemptAuthorityV1": {
      "allOf": [
        {
          "$ref": "#/$defs/EventCommon"
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "SpawnedAttemptAuthorityV1"
            },
            "event_kind": {
              "const": "S"
            },
            "payload": {
              "$ref": "#/$defs/SpawnedPayloadV1"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "TerminalAttemptAuthorityV1": {
      "allOf": [
        {
          "$ref": "#/$defs/EventCommon"
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "TerminalAttemptAuthorityV1"
            },
            "event_kind": {
              "const": "T"
            },
            "payload": {
              "oneOf": [
                {
                  "$ref": "#/$defs/ProviderTerminalPayloadV1"
                },
                {
                  "$ref": "#/$defs/SpawnedLauncherTerminalPayloadV1"
                },
                {
                  "$ref": "#/$defs/SpawnFailedTerminalPayloadV1"
                },
                {
                  "$ref": "#/$defs/AmbiguityTerminalPayloadV1"
                }
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "CompletedCurrentAuthorityV1": {
      "allOf": [
        {
          "$ref": "#/$defs/EventCommon"
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "CompletedCurrentAuthorityV1"
            },
            "event_kind": {
              "const": "K"
            },
            "payload": {
              "$ref": "#/$defs/CompletedCurrentPayloadV1"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "LifecycleEventV2": {
      "oneOf": [
        {
          "$ref": "#/$defs/ConsumedAttemptLaunchAuthorityV2"
        },
        {
          "$ref": "#/$defs/SpawnIntentAuthorityV1"
        },
        {
          "$ref": "#/$defs/SpawnAmbiguityAuthorityV1"
        },
        {
          "$ref": "#/$defs/SpawnAmbiguityResolutionAuthorityV1"
        },
        {
          "$ref": "#/$defs/SpawnedAttemptAuthorityV1"
        },
        {
          "$ref": "#/$defs/TerminalAttemptAuthorityV1"
        },
        {
          "$ref": "#/$defs/CompletedCurrentAuthorityV1"
        }
      ]
    },
    "ScopedAuthorityBase": {
      "type": "object",
      "required": [
        "schema",
        "version",
        "run_id",
        "generation",
        "attempt_ordinal",
        "record_digest"
