      "properties": {
        "terminal_digest": {
          "$ref": "#/$defs/Digest"
        },
        "prefix_digest": {
          "$ref": "#/$defs/Digest"
        },
        "neutral_reconciliation_digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "ConsumedAttemptLaunchAuthorityV2": {
      "allOf": [
        {
          "$ref": "#/$defs/EventCommon"
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "ConsumedAttemptLaunchAuthorityV2"
            },
            "event_kind": {
              "const": "C"
            },
            "payload": {
              "$ref": "#/$defs/ConsumedPayloadV2"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "SpawnIntentAuthorityV1": {
      "allOf": [
        {
          "$ref": "#/$defs/EventCommon"
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "SpawnIntentAuthorityV1"
