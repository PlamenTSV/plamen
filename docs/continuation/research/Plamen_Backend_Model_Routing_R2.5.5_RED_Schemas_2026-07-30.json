      "properties": {
        "schema": {
          "type": "string"
        },
        "version": {
          "const": 1
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "attempt_ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "record_digest": {
          "$ref": "#/$defs/Digest"
        }
      }
