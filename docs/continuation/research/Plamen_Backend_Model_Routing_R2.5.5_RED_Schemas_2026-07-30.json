            "event_kind": {
              "const": "I"
            },
            "payload": {
              "$ref": "#/$defs/IntentPayloadV1"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "SpawnAmbiguityAuthorityV1": {
      "allOf": [
        {
          "$ref": "#/$defs/EventCommon"
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "SpawnAmbiguityAuthorityV1"
            },
            "event_kind": {
              "const": "A"
            },
            "payload": {
              "$ref": "#/$defs/AmbiguityPayloadV1"
