{
  "mcpServers": {
    "slither-analyzer": {
      "command": "PLAMEN_AUTHENTICATED_FRONT",
      "args": ["MATERIALIZED_DURING_INSTALL", "slither-analyzer"],
      "_comment": "EVM static analysis. Runs reviewed local source with Plamen's locked Python runtime."
    },
    "solana-fender": {
      "command": "PLAMEN_AUTHENTICATED_FRONT",
      "args": ["MATERIALIZED_DURING_INSTALL", "solana-fender"],
      "_comment": "Optional: Solana program security analysis"
    },
    "unified-vuln-db": {
      "command": "PLAMEN_AUTHENTICATED_FRONT",
      "args": ["MATERIALIZED_DURING_INSTALL", "unified-vuln-db"],
      "_comment": "MCP server for vulnerability research. RAG database is optional — run 'plamen rag' to populate (pipeline works without it)"
    },
    "farofino": {
      "command": "PLAMEN_AUTHENTICATED_FRONT",
      "args": ["MATERIALIZED_DURING_INSTALL", "farofino"],
      "_comment": "Optional: Solidity static analysis fallback"
    },
    "foundry-suite": {
      "command": "PLAMEN_AUTHENTICATED_FRONT",
      "args": ["MATERIALIZED_DURING_INSTALL", "foundry-suite"],
      "env": {
        "RPC_URL": "YOUR_RPC_URL"
      },
      "_comment": "Optional: EVM fork testing. Get RPC from Alchemy/Infura/public endpoints"
    },
    "evm-chain-data": {
      "command": "PLAMEN_AUTHENTICATED_FRONT",
      "args": ["MATERIALIZED_DURING_INSTALL", "evm-chain-data"],
      "env": {
        "ETHERSCAN_API_KEY": "YOUR_ETHERSCAN_API_KEY"
      },
      "_comment": "Optional: On-chain contract verification. Free key: https://etherscan.io/apis"
    },
    "tavily-search": {
      "command": "PLAMEN_AUTHENTICATED_FRONT",
      "args": ["MATERIALIZED_DURING_INSTALL", "tavily-search"],
      "env": {
        "TAVILY_API_KEY": "YOUR_TAVILY_API_KEY"
      },
      "_comment": "Optional: Web search for fork ancestry + doc lookup. Key: https://tavily.com"
    },
    "helius": {
      "command": "PLAMEN_AUTHENTICATED_FRONT",
      "args": ["MATERIALIZED_DURING_INSTALL", "helius"],
      "env": {
        "HELIUS_API_KEY": "YOUR_HELIUS_API_KEY"
      },
      "_comment": "Optional: Solana on-chain data. Free key: https://helius.dev"
    },
    "memory": {
      "command": "PLAMEN_AUTHENTICATED_FRONT",
      "args": ["MATERIALIZED_DURING_INSTALL", "memory"],
      "_comment": "Persistent memory across sessions"
    }
  }
}
